PORT=4000
ADMIN_PASSWORD=change-me
JWT_SECRET=change-this-too-please

# Optional — leave both unset for local development, which then uses a
# plain local SQLite file (server/data/app.sqlite) exactly as before. Set
# both to point this server at a Turso database instead, so every device
# that talks to it shares the same data (see README.md's "Shared, public
# deployment" section).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=paste-the-token-turso-gives-you
